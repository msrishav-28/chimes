# Neon — use the *pooled* connection string on Vercel.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# First admin account. Created on migrate if the email does not exist.
# Leave ADMIN_PASSWORD empty after the first deploy; it will not overwrite.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_DISPLAY_NAME=Editor

# Optional. Only set this if you intentionally want to rotate the admin password.
# ADMIN_RESET_PASSWORD=true

# Public site origin for CSRF checks (no trailing slash).
# Local: http://127.0.0.1:3000
# Production: https://your-domain.vercel.app
# Preview + prod can be comma-separated if both must write.
CHIMES_ORIGIN=http://127.0.0.1:3000

# Cloudinary — never expose these to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared secret for POST /api/ingest (Vercel cron Authorization: Bearer …).
CRON_SECRET=

# Optional Ask LLM. If unset, Ask uses extractive search over seed + published.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# ASK_MODEL=claude-sonnet-4-5
